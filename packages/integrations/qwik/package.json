{
	"name": "@useavalon/qwik",
	"version": "0.1.9",
	"description": "Qwik integration for Avalon islands architecture",
	"license": "MIT",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "https://github.com/useAvalon/Avalon.git",
		"directory": "packages/integrations/qwik"
	},
	"homepage": "https://useavalon.dev/docs/frameworks/qwik",
	"keywords": [
		"avalon",
		"islands",
		"qwik",
		"resumable",
		"ssr",
		"lazy-loading"
	],
	"exports": {
		".": "./mod.ts",
		"./island": "./island.ts",
		"./server": "./server/renderer.ts",
		"./client": "./client/index.ts",
		"./client/hmr": "./client/hmr-adapter.ts",
		"./types": "./types.ts"
	},
	"scripts": {
		"build": "bun run ../../../scripts/build-package.ts",
		"prepublishOnly": "bun run build",
		"postpublish": "bun run ../../../scripts/postpublish.ts"
	},
	"files": [
		"**/*.ts",
		"**/*.tsx",
		"!**/__tests__/**",
		"!**/*.test.ts",
		"!vitest.config.ts",
		"README.md"
	],
	"dependencies": {
		"@useavalon/avalon": "workspace:^",
		"@useavalon/core": "workspace:^"
	},
	"peerDependencies": {
		"@builder.io/qwik": "^1.5.0",
		"vite": "^8.0.0"
	},
	"peerDependenciesMeta": {
		"vite": {
			"optional": true
		}
	}
}
