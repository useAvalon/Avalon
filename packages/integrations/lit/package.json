{
	"name": "@useavalon/lit",
	"version": "0.1.3",
	"description": "Lit integration for Avalon islands architecture",
	"license": "MIT",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "https://github.com/useAvalon/Avalon.git",
		"directory": "packages/integrations/lit"
	},
	"homepage": "https://useavalon.dev/docs/frameworks/lit",
	"keywords": [
		"avalon",
		"islands",
		"lit",
		"web-components",
		"ssr",
		"hydration"
	],
	"exports": {
		".": "./mod.ts",
		"./island": "./island.ts",
		"./server": "./server/renderer.ts",
		"./client": "./client/index.ts",
		"./client/hmr": "./client/hmr-adapter.ts",
		"./types": "./types.ts"
	},
	"files": [
		"**/*.ts",
