{
	"name": "@useavalon/svelte",
	"version": "0.1.11",
	"description": "Svelte integration for Avalon islands architecture",
	"license": "MIT",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "https://github.com/useAvalon/Avalon.git",
		"directory": "packages/integrations/svelte"
	},
	"homepage": "https://useavalon.dev/docs/frameworks/svelte",
	"keywords": [
		"avalon",
		"islands",
		"svelte",
		"ssr",
		"hydration",
		"compiler"
	],
	"exports": {
		".": "./mod.ts",
		"./server": "./server/renderer.ts",
		"./client": "./client/index.ts",
		"./client/hmr": "./client/hmr-adapter.ts",
		"./types": "./types.ts"
	},
	"scripts": {
		"build": "bun run ../../../scripts/build-package.ts",
		"prepublishOnly": "bun run build",
		"postpublish": "bun run ../../../scripts/postpublish.ts"
	},
	"files": [
		"**/*.ts",
		"**/*.tsx",
		"!**/__tests__/**",
		"!**/*.test.ts",
		"!vitest.config.ts",
		"README.md"
	],
	"dependencies": {
		"@useavalon/avalon": "workspace:^",
		"@useavalon/core": "workspace:^",
		"@sveltejs/vite-plugin-svelte": "^5.0.3"
	},
	"peerDependencies": {
		"svelte": "^5.0.0",
		"vite": "^8.0.0"
	},
	"peerDependenciesMeta": {
		"vite": {
			"optional": true
		}
	}
}
