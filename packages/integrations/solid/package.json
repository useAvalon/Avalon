{
	"name": "@useavalon/solid",
	"version": "0.1.17",
	"description": "Solid.js integration for Avalon islands architecture",
	"license": "MIT",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "https://github.com/useAvalon/Avalon.git",
		"directory": "packages/integrations/solid"
	},
	"homepage": "https://useavalon.dev/docs/frameworks/solid",
	"keywords": [
		"avalon",
		"islands",
		"solid",
		"solidjs",
		"ssr",
		"hydration",
		"reactive"
	],
	"exports": {
		".": "./mod.ts",
		"./server": "./server/renderer.ts",
		"./client": "./client/index.ts",
		"./client/hmr": "./client/hmr-adapter.ts",
		"./types": "./types.ts"
	},
	"scripts": {
		"build": "bun run ../../../scripts/build-package.ts",
		"prepublishOnly": "bun run build",
		"postpublish": "bun run ../../../scripts/postpublish.ts"
	},
	"files": [
		"**/*.ts",
		"**/*.tsx",
		"!**/__tests__/**",
		"!**/*.test.ts",
		"!vitest.config.ts",
		"README.md"
	],
	"dependencies": {
		"@useavalon/avalon": "workspace:^",
		"@useavalon/core": "workspace:^",
		"vite-plugin-solid": "^2.11.14"
	},
	"peerDependencies": {
		"solid-js": "^1.8.0",
		"vite": "^8.0.0"
	},
	"peerDependenciesMeta": {
		"vite": {
			"optional": true
		}
	}
}
