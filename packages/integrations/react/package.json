{
	"name": "@useavalon/react",
	"version": "0.1.11",
	"description": "React integration for Avalon islands architecture",
	"license": "MIT",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "https://github.com/useAvalon/Avalon.git",
		"directory": "packages/integrations/react"
	},
	"homepage": "https://useavalon.dev/docs/frameworks/react",
	"keywords": [
		"avalon",
		"islands",
		"react",
		"ssr",
		"hydration",
		"jsx"
	],
	"exports": {
		".": "./mod.ts",
		"./server": "./server/renderer.ts",
		"./client": "./client/index.ts",
		"./client/hmr": "./client/hmr-adapter.ts",
		"./types": "./types.ts"
	},
	"scripts": {
		"build": "bun run ../../../scripts/build-package.ts",
		"prepublishOnly": "bun run build",
		"postpublish": "bun run ../../../scripts/postpublish.ts"
	},
	"files": [
		"**/*.ts",
		"**/*.tsx",
		"!**/__tests__/**",
		"!**/*.test.ts",
		"!vitest.config.ts",
		"README.md"
	],
	"dependencies": {
		"@useavalon/avalon": "workspace:^",
		"@useavalon/core": "workspace:^",
		"@vitejs/plugin-react": "^4.5.2"
	},
	"peerDependencies": {
		"react": "^18.0.0 || ^19.0.0",
		"react-dom": "^18.0.0 || ^19.0.0",
		"vite": "^8.0.0"
	},
	"peerDependenciesMeta": {
		"vite": {
			"optional": true
		}
	},
	"devDependencies": {
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0"
	}
}
