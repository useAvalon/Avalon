{
	"name": "@useavalon/agent-optimization",
	"version": "0.1.5",
	"description": "AI agent and SEO optimization plugin for Avalon — JSON-LD, llms.txt, markdown negotiation, sitemaps",
	"license": "MIT",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/useAvalon/Avalon.git",
		"directory": "packages/agent-optimization"
	},
	"homepage": "https://useavalon.dev/docs/plugins/agent-optimization",
	"keywords": [
		"avalon",
		"seo",
		"json-ld",
		"llms-txt",
		"sitemap",
		"ai-agents",
		"structured-data"
	],
	"exports": {
		".": "./mod.ts"
	},
	"scripts": {
		"build": "bun run scripts/build.ts",
		"prepublishOnly": "bun run build"
	},
	"files": [
		"mod.ts",
		"src/**/*.ts",
		"!src/**/__tests__/**",
		"!src/**/*.test.ts",
		"README.md"
	],
	"dependencies": {
		"@useavalon/avalon": "workspace:^",
		"zod": "^4.3.6"
	},
	"peerDependencies": {
		"vite": "^8.0.0"
	},
	"peerDependenciesMeta": {
		"vite": {
			"optional": true
		}
	},
	"devDependencies": {
		"fast-check": "^4.6.0",
		"oxc-minify": "^0.120.0",
		"oxc-transform": "^0.120.0",
		"vitest": "^4.1.0"
	}
}
