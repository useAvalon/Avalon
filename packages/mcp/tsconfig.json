{
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"esModuleInterop": true,
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"resolveJsonModule": true,
		"lib": ["esnext"]
	},
	"include": ["mod.ts", "bin/**/*.ts", "src/**/*.ts"],
	"exclude": ["node_modules", "dist"]
}
