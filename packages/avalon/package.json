{
	"name": "@useavalon/avalon",
	"version": "0.5.3",
	"description": "Multi-framework islands architecture for the modern web",
	"license": "MIT",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/useAvalon/Avalon.git",
		"directory": "packages/avalon"
	},
	"homepage": "https://useavalon.dev",
	"keywords": [
		"avalon",
		"islands",
		"ssr",
		"ssg",
		"vite",
		"preact",
		"react",
		"vue",
		"svelte",
		"solid",
		"lit",
		"qwik",
		"multi-framework",
		"hydration",
		"web-components",
		"markdown",
		"mdx"
	],
	"bin": {
		"avalon": "bin/avalon.ts"
	},
	"scripts": {
		"build:client": "bun run scripts/build-client.ts",
		"build": "bun run scripts/build.ts",
		"prepublishOnly": "bun run build",
		"postpublish": "bun run scripts/postpublish.ts"
	},
	"exports": {
		".": "./mod.ts",
		"./actions": "./src/actions/define.ts",
		"./cron": "./src/cron/define.ts",
		"./client": "./src/client/components.ts",
		"./client/main": "./src/client/main.js",
		"./client/main-slim": "./src/client/main-slim.js",
		"./client/router": "./src/client/router/index.ts",
		"./client/strategies": "./src/client/strategies.js",
		"./client/hmr": "./src/client/framework-adapter.ts",
		"./islands/framework-detection": "./src/islands/framework-detection.ts",
		"./islands/integration-registry": "./src/core/integrations/registry.ts",
		"./islands/universal-css-collector": "./src/islands/universal-css-collector.ts",
		"./islands/universal-head-collector": "./src/islands/universal-head-collector.ts",
		"./middleware": "./src/middleware/index.ts",
		"./nitro/renderer": "./src/nitro/renderer.ts",
		"./nitro/types": "./src/nitro/types.ts",
		"./nitro/config": "./src/nitro/config.ts",
		"./types/island-jsx": "./src/types/island-jsx.d.ts",
		"./types": "./src/types/index.d.ts",
		"./prerender": "./src/prerender/index.ts",
		"./post-build": "./src/post-build/index.ts",
		"./render/collect-css": "./src/render/collect-css.ts",
		"./render/dev-css-select": "./src/render/dev-css-select.ts",
		"./render/shell-engine": "./src/render/shell-engine.ts"
	},
	"typesVersions": {
		"*": {
			"types": [
				"./src/types/index.d.ts"
			]
		}
	},
	"files": [
		"mod.ts",
		"bin/**/*.ts",
		"src/**/*.ts",
		"src/**/*.tsx",
		"src/**/*.js",
		"src/**/*.d.ts",
		"!src/**/*.test.ts",
		"!src/**/tests/**",
		"!src/**/__tests__/**",
		"README.md"
	],
	"devDependencies": {
		"@types/mime-types": "^3.0.1",
		"oxc-minify": "^0.152.0"
	},
	"peerDependencies": {
		"vite": "^8.0.0",
		"nitro": "^3.0.260903-beta",
		"vite-imagetools": "^11.0.0"
	},
	"peerDependenciesMeta": {
		"nitro": {
			"optional": true
		},
		"vite": {
			"optional": true
		},
		"vite-imagetools": {
			"optional": true
		}
	},
	"dependencies": {
		"@mdx-js/rollup": "^3.0.0",
		"rehype-highlight": "^7.0.0",
		"@useavalon/core": "workspace:^",
		"h3": "^2.0.1-rc.32",
		"marked": "^17.0.4",
		"oxc-parser": "^0.152.0",
		"oxc-transform": "^0.152.0",
		"preact": "11.0.0",
		"preact-render-to-string": "6.8.0",
		"remark-frontmatter": "^5.0.0",
		"remark-gfm": "^4.0.0",
		"remark-mdx-frontmatter": "^5.2.0",
		"unified": "^11.0.0",
		"urlpattern-polyfill": "^10.1.0",
		"zod": "^4.6.5"
	},
	"overrides": {
		"sharp": ">=0.35.4",
		"toml": ">=4.2.0",
		"yaml": ">=2.8.3"
	}
}
