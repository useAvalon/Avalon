{
	"name": "@useavalon/avalon",
	"version": "0.1.82",
	"description": "Multi-framework islands architecture for the modern web",
	"license": "MIT",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/useAvalon/Avalon.git",
		"directory": "packages/avalon"
	},
	"homepage": "https://useavalon.dev",
	"keywords": [
		"avalon",
		"islands",
		"ssr",
		"ssg",
		"vite",
		"preact",
		"react",
		"vue",
		"svelte",
		"solid",
		"lit",
		"qwik",
		"multi-framework",
		"hydration",
		"web-components",
		"markdown",
		"mdx"
	],
	"scripts": {
		"build:client": "bun run scripts/build-client.ts",
		"build": "bun run scripts/build.ts",
		"prepublishOnly": "bun run build",
		"postpublish": "bun run scripts/postpublish.ts"
	},
	"exports": {
		".": {
			"types": "./dist/mod.d.ts",
			"default": "./dist/mod.js"
		},
		"./client": {
			"types": "./dist/src/client/components.d.ts",
			"default": "./dist/src/client/components.js"
		},
		"./client/main": {
			"types": "./dist/src/client/main.d.ts",
			"default": "./dist/src/client/main.js"
		},
		"./client/main-slim": {
			"types": "./dist/src/client/main-slim.d.ts",
			"default": "./dist/src/client/main-slim.js"
		},
		"./client/strategies": {
			"types": "./dist/src/client/strategies.d.ts",
			"default": "./dist/src/client/strategies.js"
		},
		"./client/hmr": {
			"types": "./dist/src/client/framework-adapter.d.ts",
			"default": "./dist/src/client/framework-adapter.js"
		},
		"./islands/framework-detection": {
			"types": "./dist/src/islands/framework-detection.d.ts",
			"default": "./dist/src/islands/framework-detection.js"
		},
		"./islands/integration-registry": {
			"types": "./dist/src/core/integrations/registry.d.ts",
			"default": "./dist/src/core/integrations/registry.js"
		},
		"./islands/universal-css-collector": {
			"types": "./dist/src/islands/universal-css-collector.d.ts",
			"default": "./dist/src/islands/universal-css-collector.js"
		},
		"./islands/universal-head-collector": {
			"types": "./dist/src/islands/universal-head-collector.d.ts",
			"default": "./dist/src/islands/universal-head-collector.js"
		},
		"./middleware": {
			"types": "./dist/src/middleware/index.d.ts",
			"default": "./dist/src/middleware/index.js"
		},
		"./nitro/renderer": {
			"types": "./dist/src/nitro/renderer.d.ts",
			"default": "./dist/src/nitro/renderer.js"
		},
		"./nitro/types": {
			"types": "./dist/src/nitro/types.d.ts",
			"default": "./dist/src/nitro/types.js"
		},
		"./nitro/config": {
			"types": "./dist/src/nitro/config.d.ts",
			"default": "./dist/src/nitro/config.js"
		},
		"./types/island-jsx": "./dist/src/types/island-jsx.d.ts",
		"./types": "./dist/src/types/index.d.ts",
		"./prerender": {
			"types": "./dist/src/prerender/index.d.ts",
			"default": "./dist/src/prerender/index.js"
		},
		"./post-build": {
			"types": "./dist/src/post-build/index.d.ts",
			"default": "./dist/src/post-build/index.js"
		},
		"./render/collect-css": {
			"types": "./dist/src/render/collect-css.d.ts",
			"default": "./dist/src/render/collect-css.js"
		}
	},
	"typesVersions": {
		"*": {
			"types": [
				"./dist/src/types/index.d.ts"
			]
		}
	},
	"files": [
		"dist/**/*.js",
		"dist/**/*.d.ts",
		"README.md"
	],
	"devDependencies": {
		"@types/mime-types": "^3.0.1",
		"oxc-minify": "^0.120.0"
	},
	"peerDependencies": {
		"vite": "^8.0.0",
		"nitro": "^3.0.260311-beta",
		"vite-imagetools": "^7.0.0",
		"rehype-highlight": "^7.0.0"
	},
	"peerDependenciesMeta": {
		"nitro": {
			"optional": true
		},
		"vite": {
			"optional": true
		},
		"vite-imagetools": {
			"optional": true
		},
		"rehype-highlight": {
			"optional": true
		}
	},
	"dependencies": {
		"@useavalon/core": "^0.1.7",
		"@mdx-js/rollup": "^3.0.0",
		"h3": "^2.0.1-rc.16",
		"marked": "^17.0.4",
		"oxc-transform": "^0.117.0",
		"preact": "10.28.4",
		"preact-render-to-string": "6.6.6",
		"remark-frontmatter": "^5.0.0",
		"remark-gfm": "^4.0.0",
		"remark-mdx-frontmatter": "^5.0.0",
		"unified": "^11.0.0",
		"zod": "^4.3.6"
	}
}
