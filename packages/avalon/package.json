{
	"name": "@useavalon/avalon",
	"version": "0.1.23",
	"description": "Multi-framework islands architecture for the modern web",
	"license": "MIT",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/useAvalon/Avalon.git",
		"directory": "packages/avalon"
	},
	"homepage": "https://useavalon.dev",
	"keywords": [
		"avalon",
		"islands",
		"ssr",
		"ssg",
		"vite",
		"preact",
		"react",
		"vue",
		"svelte",
		"solid",
		"lit",
		"qwik",
		"multi-framework",
		"hydration",
		"web-components",
		"markdown",
		"mdx"
	],
	"scripts": {
		"build:client": "bun run scripts/build-client.ts",
		"build": "bun run scripts/build.ts",
		"prepublishOnly": "bun run build",
		"postpublish": "bun run scripts/postpublish.ts"
	},
	"exports": {
		".": "./mod.ts",
		"./client": "./src/client/components.ts",
		"./client/hmr": "./src/client/framework-adapter.ts",
		"./islands/framework-detection": "./src/islands/framework-detection.ts",
		"./middleware": "./src/middleware/index.ts",
		"./nitro/renderer": "./src/nitro/renderer.ts",
		"./nitro/types": "./src/nitro/types.ts",
		"./nitro/config": "./src/nitro/config.ts",
		"./types/island-jsx": "./src/types/island-jsx.d.ts",
		"./types": "./src/types/index.d.ts"
	},
	"typesVersions": {
		"*": {
			"types": [
				"./src/types/index.d.ts"
			]
		}
	},
	"files": [
		"mod.ts",
		"src/**/*.ts",
		"src/**/*.tsx",
		"src/**/*.js",
		"src/**/*.d.ts",
		"!src/**/*.test.ts",
		"!src/**/tests/**",
		"!src/**/__tests__/**",
		"README.md"
	],
	"devDependencies": {
		"@types/mime-types": "^3.0.1",
		"oxc-minify": "^0.120.0"
	},
	"peerDependencies": {
		"vite": "^8.0.0",
		"nitro": "^3.0.260311-beta",
		"vite-imagetools": "^7.0.0",
		"rehype-highlight": "^7.0.0"
	},
	"peerDependenciesMeta": {
		"nitro": {
			"optional": true
		},
		"vite": {
			"optional": true
		},
		"vite-imagetools": {
			"optional": true
		},
		"rehype-highlight": {
			"optional": true
		}
	},
	"dependencies": {
		"@useavalon/core": "workspace:^",
		"@mdx-js/rollup": "^3.0.0",
		"h3": "^2.0.1-rc.16",
		"marked": "^17.0.4",
		"oxc-transform": "^0.117.0",
		"preact": "10.28.4",
		"preact-render-to-string": "6.6.6",
		"remark-frontmatter": "^5.0.0",
		"remark-gfm": "^4.0.0",
		"remark-mdx-frontmatter": "^5.0.0",
		"unified": "^11.0.0",
		"zod": "^4.3.6"
	}
}
