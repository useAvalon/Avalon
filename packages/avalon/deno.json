{
	"name": "@avalon/avalon",
	"version": "0.1.1",
	"license": "MIT",
	"nodeModulesDir": "auto",

	"exports": {
		".": "./mod.ts"
	},

	"imports": {
		"@/": "./src/",
		"@/utils/": "./src/utils/",
		"@/schemas/": "./src/schemas/",
		"@deno/vite-plugin": "npm:@deno/vite-plugin@^1.0.5",
		"@std/fs": "jsr:@std/fs@^1.0.8",
		"@std/media-types": "jsr:@std/media-types@^1.1.0",
		"@std/path": "jsr:@std/path@^1.0.8",
		"@std/assert": "jsr:@std/assert",
		"@std/testing": "jsr:@std/testing",
		"marked": "npm:marked@^17.0.1",

		"preact": "npm:preact@10.26.9",
		"preact/hooks": "npm:preact@10.26.9/hooks",
		"preact-render-to-string": "npm:preact-render-to-string@6.5.13",
		
		"vite": "npm:vite@7.1.5",
		"typescript": "npm:typescript@5.3.3",
		"zod": "npm:zod@3.25.28",

		"@mdx-js/rollup": "npm:@mdx-js/rollup@^3.0.0",
		"@mdx-js/react": "npm:@mdx-js/react@^3.0.0",
		"@types/mdx": "npm:@types/mdx@^2.0.0",
		"remark-gfm": "npm:remark-gfm@^4.0.0",
		"remark-frontmatter": "npm:remark-frontmatter@^5.0.0",
		"remark-mdx-frontmatter": "npm:remark-mdx-frontmatter@^5.0.0",
		"rehype-highlight": "npm:rehype-highlight@^7.0.0",
		"unified": "npm:unified@^11.0.0",
		"lowlight": "npm:lowlight@^3.1.0",
		"hast-util-to-text": "npm:hast-util-to-text@^4.0.0"
	},

	"compilerOptions": {
		"jsx": "precompile",
		"jsxImportSource": "preact",
		"lib": ["dom", "dom.iterable", "esnext", "deno.ns"],
		"types": [
			"vite/client",
			"./src/types/mdx.d.ts",
			"./src/client/types/vite-virtual-modules.d.ts",
			"./src/client/types/framework-runtime.d.ts"
		],
		"checkJs": false
	},

	"publish": {
		"include": ["mod.ts", "src/**/*", "README.md", "deno.json"],
		"exclude": [
			"node_modules/**/*",
			"npm:**/*",
			"**/*.test.ts",
			"**/test/**/*",
			"**/tests/**/*"
		]
	}
}
