{
	"$schema": "https://biomejs.dev/schemas/2.4.7/schema.json",
	"assist": {
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"lineWidth": 100
	},
	"linter": {
		"enabled": true,
		"rules": {
			"correctness": {
				"useQwikValidLexicalScope": "off",
				"noUnusedFunctionParameters": "warn",
				"useImageSize": "warn"
			},
			"security": {
				"noDangerouslySetInnerHtml": "off"
			},
			"suspicious": {
				"noCommentText": "off",
				"noSuspiciousSemicolonInJsx": "off",
				"noArrayIndexKey": "off",
				"useIterableCallbackReturn": "warn"
			},
			"style": {
				"noNonNullAssertion": "warn",
				"useTemplate": "warn"
			},
			"a11y": {
				"useValidAnchor": "warn",
				"useButtonType": "warn",
				"noStaticElementInteractions": "off",
				"useKeyWithClickEvents": "off"
			}
		}
	},
	"overrides": [
		{
			"includes": ["www/inspiration/**"],
			"linter": {
				"enabled": false
			}
		}
	],
	"files": {
		"includes": ["**/*.ts", "**/*.tsx", "**/*.js", "**/*.jsx", "**/*.json", "**/*.css"]
	}
}
