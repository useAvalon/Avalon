{
	"name": "avalon-monorepo",
	"private": true,
	"workspaces": [
		"packages/avalon",
		"packages/agent-optimization",
		"packages/mcp",
		"packages/seo",
		"packages/create-avalon",
		"packages/integrations/*",
		"www",
		"examples/*"
	],
	"scripts": {
		"dev": "bun run --filter avalon-demo dev",
		"build": "bun run --filter avalon-demo build",
		"test": "bunx vitest run",
		"test:install": "bun scripts/smoke-create-avalon.ts",
		"lint": "bunx biome check .",
		"format": "bunx biome format --write .",
		"typecheck": "bunx tsc --noEmit",
		"prepare": "husky"
	},
	"lint-staged": {
		"*.{ts,tsx,js,jsx,json,css}": [
			"biome check --write --no-errors-on-unmatched"
		]
	},
	"devDependencies": {
		"@babel/plugin-proposal-decorators": "^7.29.0",
		"@babel/plugin-transform-class-properties": "^7.28.6",
		"@babel/plugin-transform-typescript": "^7.28.6",
		"@biomejs/biome": "^2.4.15",
		"@rolldown/plugin-babel": "^0.2.3",
		"@tailwindcss/vite": "^4.1.8",
		"@types/bun": "^1.3.14",
		"@types/react": "^19.2.0",
		"@types/react-dom": "^19.2.0",
		"esbuild": "^0.27.4",
		"fast-check": "^4.8.0",
		"husky": "^9.1.7",
		"lint-staged": "^16.4.0",
		"oxc-minify": "^0.120.0",
		"oxc-transform": "^0.120.0",
		"typescript": "^5.9.3",
		"vite": "8.0.12",
		"vitest": "^4.1.6"
	},
	"overrides": {
		"vite": "8.0.12"
	},
	"dependencies": {
		"estree-walker": "^3.0.3",
		"nitro": "^3.0.260311-beta",
		"zod": "4.3.6"
	}
}
