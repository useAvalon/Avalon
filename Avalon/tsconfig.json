{
	"extends": "../tsconfig.json",
	"compilerOptions": {
		"allowArbitraryExtensions": true,
		"baseUrl": ".",
		"paths": {
			"$components/*": ["./src/components/*"],
			"$pages/*": ["./src/pages/*"],
			"$layouts/*": ["./src/layouts/*"],
			"$islands/*": ["./src/islands/*"],
			"#imports": ["./.nitro/types/nitro-imports.d.ts"]
		},
		"types": ["nitro/types"]
	},
	"include": [
		"src/**/*.ts",
		"src/**/*.tsx",
		"src/**/*.d.ts",
		"server/**/*.ts",
		"server/**/*.d.ts",
		"routes/**/*.ts",
		"middleware/**/*.ts",
		"nitro.config.ts"
	]
}
