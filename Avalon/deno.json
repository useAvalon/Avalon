		"@types/js-yaml": "npm:@types/js-yaml@^4.0.0",
		"source-map": "npm:source-map@^0.7.4",
		"estree-walker": "npm:estree-walker@^3.0.0",
		"periscopic": "npm:periscopic@^4.0.0",
		"@rollup/pluginutils": "npm:@rollup/pluginutils@^5.0.0",
