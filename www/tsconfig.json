{
	"extends": "../tsconfig.json",
	"compilerOptions": {
		"experimentalDecorators": true,
		"allowArbitraryExtensions": true,
		"paths": {
			"@shared/*": ["./app/shared/*"],
			"@modules/*": ["./app/modules/*"],
			"#imports": ["./.nitro/types/nitro-imports.d.ts"]
		},
		"types": ["nitro/types"]
	},
	"include": [
		"app/**/*.ts",
		"app/**/*.tsx",
		"app/**/*.d.ts",
		"src/**/*.ts",
		"src/**/*.d.ts",
		"server/**/*.ts",
		"server/**/*.d.ts",
		"routes/**/*.ts",
		"middleware/**/*.ts",
		"nitro.config.ts",
		"../packages/avalon/src/types/index.d.ts"
	]
}
