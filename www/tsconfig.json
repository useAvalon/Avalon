{
	"extends": "../tsconfig.json",
	"compilerOptions": {
		"experimentalDecorators": true,
		"allowArbitraryExtensions": true,
		"paths": {
			"@shared/*": ["./app/shared/*"],
			"@modules/*": ["./app/modules/*"],
			"#imports": ["./.nitro/types/nitro-imports.d.ts"]
		},
		"types": ["nitro/types"]
	},
	"include": [
		"app/**/*.ts",
		"app/**/*.tsx",
		"app/**/*.d.ts",
		"src/**/*.ts",
		"src/**/*.d.ts",
		"server/**/*.ts",
		"server/**/*.d.ts",
		"routes/**/*.ts",
		"middleware/**/*.ts",
		"nitro.config.ts",
		"../packages/avalon/src/types/index.d.ts"
	],
	"exclude": [
		"app/**/*.react.tsx",
		"app/**/*.react.jsx",
		"app/**/*.solid.tsx",
		"app/**/*.solid.jsx",
		"app/**/*.qwik.tsx",
		"app/**/*.qwik.jsx"
	],
	"references": [
		{ "path": "./tsconfig.react.json" },
		{ "path": "./tsconfig.solid.json" },
		{ "path": "./tsconfig.qwik.json" }
	]
}
