# Cloudflare Pages static headers. CSP is defined here for static assets; the Worker adds CSP only for SSR/API.
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Vary: Accept-Encoding
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self'; upgrade-insecure-requests

# Pagefind assets inherit CSP from /* above; cache only here to avoid duplicate policies.
/pagefind/*
  Cache-Control: public, max-age=3600, must-revalidate

/pagefind/pagefind-worker.js
  Cache-Control: public, no-cache, must-revalidate

/pagefind/pagefind.js
  Cache-Control: public, no-cache, must-revalidate

/*.html
  Cache-Control: public, max-age=3600, s-maxage=31536000

/404.html
  Cache-Control: public, max-age=3600, s-maxage=31536000

/docs/*
  Cache-Control: public, max-age=3600, s-maxage=31536000

/blog/*
  Cache-Control: public, max-age=3600, s-maxage=31536000

/demo/*
  Cache-Control: public, max-age=3600, s-maxage=31536000

/
  Cache-Control: public, max-age=3600, s-maxage=31536000

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/font-faces.css
  Cache-Control: public, max-age=86400

/islands/*
  Cache-Control: public, max-age=0, must-revalidate
